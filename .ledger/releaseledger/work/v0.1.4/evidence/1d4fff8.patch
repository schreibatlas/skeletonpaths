+import json
+import subprocess
+import sys
+from pathlib import Path
+
+
+def test_subpixel_benchmark_smoke_reports_bounded_metrics():
+    root = Path(__file__).resolve().parents[1]
+    completed = subprocess.run(
+        [
+            sys.executable,
+            str(root / "benchmarks" / "benchmark_subpixel.py"),
+            "--side",
+            "64",
+            "--repeats",
+            "1",
+            "--json",
+        ],
+        check=True,
+        capture_output=True,
+        text=True,
+        timeout=60,
+        cwd=root,
+    )
